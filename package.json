{
  "name": "@stackline/load-plugin",
  "version": "1.0.2",
  "description": "Resolve and load plugins, submodules, and files with the load-plugin 5 Promise API",
  "license": "MIT",
  "keywords": [
    "stackline",
    "load",
    "submodule",
    "package",
    "plugin",
    "resolve",
    "module",
    "esm",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-load-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-load-plugin/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/wooorm"
  },
  "author": "Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)",
  "contributors": [
    "Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "CHANGELOG.md",
    "NOTICE",
    "DEPENDENCY_UPDATES.md"
  ],
  "dependencies": {
    "@npmcli/config": "^10.13.0",
    "import-meta-resolve": "npm:@stackline/import-meta-resolve@1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "remark-lint": "npm:@stackline/remark-lint@1.0.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "tsc --build --clean && tsc --build",
    "test": "node --conditions development test/index.js && node --test test/prefix.js",
    "lint": "node --check index.js",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "bracketSpacing": false,
    "semi": false,
    "trailingComma": "none"
  },
  "homepage": "https://github.com/alexandroit/stackline-load-plugin#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
