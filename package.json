{
  "name": "@stackline/load-plugin",
  "version": "1.0.0",
  "description": "Load a submodule, plugin, or file",
  "license": "MIT",
  "keywords": [
    "load",
    "submodule",
    "package",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-load-plugin.git"
  },
  "bugs": "https://github.com/alexandroit/stackline-load-plugin/issues",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/wooorm"
  },
  "author": "Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)",
  "contributors": [
    "Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "dependencies": {
    "@npmcli/config": "^10.13.0",
    "import-meta-resolve": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "remark-lint": "^9.0.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "tsc --build --clean && tsc --build",
    "test": "node --conditions development test/index.js && node --test test/prefix.js",
    "lint": "node --check index.js",
    "prepack": "npm run build"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "bracketSpacing": false,
    "semi": false,
    "trailingComma": "none"
  },
  "homepage": "https://github.com/alexandroit/stackline-load-plugin#readme",
